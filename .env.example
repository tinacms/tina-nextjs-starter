# Values come from your project at https://app.tina.io.
# For local development, copy this file to `.env` and uncomment the lines you use.
# The lines are commented out on purpose. The "Deploy to Cloudflare" button turns
# every uncommented line into a required Worker runtime secret, but this starter
# only reads these values at build time.
# NEXT_PUBLIC_TINA_CLIENT_ID=
# TINA_TOKEN=

# Set by Vercel, Netlify and Cloudflare Workers Builds. Uncomment to override.
# NEXT_PUBLIC_TINA_BRANCH=
# To see the preview functionality
# VERCEL_ENV=preview
